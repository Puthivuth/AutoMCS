# Copy to .env (never commit .env)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE=0                # set to 1 behind HTTPS in production
POSTGRES_DB=automcs
POSTGRES_USER=automcs
POSTGRES_PASSWORD=change-me
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY=                  # alias for GEMINI_API_KEY_1
GEMINI_MODEL=gemini-3.8-flash    # vision-capable Gemini model id
# Persistent host paths (outside the replaceable source tree)
AUTOMCS_DATA_HOST=/srv/automcs/data
AUTOMCS_PGDATA_HOST=/srv/automcs/pgdata
